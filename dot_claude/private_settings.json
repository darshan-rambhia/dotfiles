{
  "cleanupPeriodDays": 120,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "DK_OUTCOME_MAX_RETRIES": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.build.dkinternal.com",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_RESOURCE_ATTRIBUTES": "user.email=d.rambhia@draftkings.com"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "modelPicker": {
    "options": [
      {
        "model": "opus",
        "label": "Opus 5.5",
        "description": "Complex tasks"
      },
      {
        "model": "opus[1m]",
        "label": "Opus 5.5 (1M context)",
        "description": "Long sessions"
      },
      {
        "model": "sonnet",
        "label": "Sonnet 5.5",
        "description": "Fast, cheaper"
      },
      {
        "model": "claude-fable-5-2",
        "label": "Fable 5.2",
        "description": "Fable 5.2"
      }
    ],
    "replaceBuiltInOptions": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/Code/Repositories/draftkings/dk-tools/hooks/post_tool_track.py",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/Code/Repositories/draftkings/dk-tools/hooks/post_tool_track.py",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/precompact-mine.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-tool-update.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/Code/Repositories/draftkings/dk-tools/hooks/pre_tool_track.py",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash|Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/.claude/hooks/guardrails.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-session-start.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-session-stop.sh",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/check-em-dash.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/.claude/hooks/dk_context_filter.py"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash /Users/d.rambhia/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": false,
    "dk-tool-telemetry@DraftKings-ClaudeCode-Plugin-Marketplace": true,
    "impeccable@impeccable": false,
    "mattpocock-skills@mattpocock": false,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "DraftKings-ClaudeCode-Plugin-Marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/d.rambhia/Code/Repositories/draftkings/claudecode-marketplace"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "permissions": {
    "deny": [
      "ListAgents",
      "ReportFindings",
      "ScheduleWakeup",
      "Workflow"
    ]
  }
}
