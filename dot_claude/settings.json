{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.build.dkinternal.com",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_RESOURCE_ATTRIBUTES": "user.email=d.rambhia@draftkings.com",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "us.anthropic.claude-fable-5-1",
    "ANTHROPIC_DEFAULT_MODEL": "us.anthropic.claude-opus-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Sonnet 5.5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Sonnet 5.5 · fast, cheaper"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-session-start.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-tool-update.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/Code/Repositories/draftkings/dk-tools/hooks/pre_tool_track.py",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-session-stop.sh",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/check-em-dash.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/precompact-mine.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/d.rambhia/Code/Repositories/draftkings/dk-tools/hooks/post_tool_track.py",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/d.rambhia/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "ponytail@ponytail": true,
    "dk-tool-telemetry@DraftKings-ClaudeCode-Plugin-Marketplace": true,
    "mattpocock-skills@mattpocock": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "DraftKings-ClaudeCode-Plugin-Marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/d.rambhia/Code/Repositories/draftkings/claudecode-marketplace"
      }
    },
    "darshan-local": {
      "source": {
        "source": "directory",
        "path": "/Users/d.rambhia/plugins"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      {
        "model": "us.anthropic.claude-opus-5-5",
        "label": "Opus 5.5",
        "description": "Complex tasks"
      },
      {
        "model": "us.anthropic.claude-opus-5-5[1m]",
        "label": "Opus 5.5 (1M context)",
        "description": "Long sessions"
      },
      {
        "model": "us.anthropic.claude-sonnet-5-5",
        "label": "Sonnet 5.5",
        "description": "Fast, cheaper"
      },
      {
        "model": "us.anthropic.claude-fable-5-1",
        "label": "Fable 5.1",
        "description": "Fable 5.1"
      }
    ]
  }
}
