{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-session-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/ensure-crons.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-tool-update.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/agent-session-stop.sh",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/d.rambhia/.claude/hooks/precompact-mine.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/d.rambhia/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "impeccable@impeccable": false,
    "codex@openai-codex": true,
    "bt-tools@blackthrone-plugins": true,
    "bt-game-engine@blackthrone-plugins": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "blackthrone-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/d.rambhia/Code/Repositories/draftkings/blackthrone-plugin-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "low",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
