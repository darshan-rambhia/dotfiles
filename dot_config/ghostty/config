# Ghostty config - migrated from iTerm2
# Documentation: https://ghostty.org/docs/config

# Font settings
font-family = "FiraCode Nerd Font Mono"
font-size = 11
font-feature = liga
font-feature = calt

# Theme (Nord - matches your iTerm2 color scheme)
theme = nord

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-width = 80
window-height = 25

# Minimum contrast (iTerm2 was ~42%)
minimum-contrast = 1.42

# Misc settings matching iTerm2 behavior
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Default working directory
working-directory = /Users/rambhiad/Code/Repositories/personal-projects

