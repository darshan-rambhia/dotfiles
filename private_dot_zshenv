# =============================================================================
# ~/.zshenv - Environment Variables (loaded for ALL zsh instances)
# =============================================================================
# This file is loaded first, before .zprofile, .zshrc, and .zlogin
# Only put environment variables here - no interactive shell config

# Guard against double-sourcing (e.g. when .zshrc re-sources this file)
[[ -n "$ZSHENV_LOADED" ]] && return
export ZSHENV_LOADED=1

# =============================================================================
# XDG Base Directory Specification
# =============================================================================
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Create XDG directories if they don't exist
[[ -d "$XDG_CONFIG_HOME" ]] || mkdir -p "$XDG_CONFIG_HOME"
[[ -d "$XDG_DATA_HOME" ]] || mkdir -p "$XDG_DATA_HOME"
[[ -d "$XDG_STATE_HOME" ]] || mkdir -p "$XDG_STATE_HOME"
[[ -d "$XDG_CACHE_HOME" ]] || mkdir -p "$XDG_CACHE_HOME"

# =============================================================================
# Zsh XDG Compliance
# =============================================================================
# ZDOTDIR tells zsh to look for .zshrc in this directory instead of $HOME
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
[ -d "$ZDOTDIR" ] || mkdir -p "$ZDOTDIR"

# Zsh state files (history, completion cache)
export HISTFILE="$XDG_STATE_HOME/zsh/history"
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump"
[ -d "$XDG_STATE_HOME/zsh" ] || mkdir -p "$XDG_STATE_HOME/zsh"
[ -d "$XDG_CACHE_HOME/zsh" ] || mkdir -p "$XDG_CACHE_HOME/zsh"

# =============================================================================
# Development Tools - XDG Compliance
# =============================================================================
# Go
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"

# Node.js / npm
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"

# .NET (data: ~/.dotnet -> ~/.local/share/dotnet, cache: ~/.nuget -> ~/.cache/nuget)
export DOTNET_CLI_HOME="$XDG_DATA_HOME/dotnet"
export DOTNET_ROOT="/usr/local/share/dotnet"
export NUGET_PACKAGES="$XDG_CACHE_HOME/nuget/packages"
export DOTNET_NOLOGO=1

# Python
export PYTHONSTARTUP="$XDG_CONFIG_HOME/python/pythonrc"
export PYLINTHOME="$XDG_CACHE_HOME/pylint"
export IPYTHONDIR="$XDG_CONFIG_HOME/ipython"
export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME/jupyter"

# =============================================================================
# CLI Tools - XDG Compliance
# =============================================================================
# Less
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
[[ -d "$XDG_STATE_HOME/less" ]] || mkdir -p "$XDG_STATE_HOME/less"

# GNU Readline
export INPUTRC="$XDG_CONFIG_HOME/readline/inputrc"

# wget
export WGETRC="$XDG_CONFIG_HOME/wgetrc"

# Docker / Rancher Desktop
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export DOCKER_HOST="unix://$HOME/.rd/docker.sock"

# GnuPG
export GNUPGHOME="$XDG_DATA_HOME/gnupg"

# =============================================================================
# Cloud & DevOps Tools
# =============================================================================
# AWS
export AWS_CONFIG_FILE="$XDG_CONFIG_HOME/aws/config"
export AWS_SHARED_CREDENTIALS_FILE="$XDG_CONFIG_HOME/aws/credentials"

# Kubernetes
export KUBECONFIG="$XDG_CONFIG_HOME/kube/config"

# Terraform
export TF_CLI_CONFIG_FILE="$XDG_CONFIG_HOME/terraform/terraformrc"

# =============================================================================
# Database Configs & Histories
# =============================================================================
export PSQLRC="$XDG_CONFIG_HOME/pg/psqlrc"
export MYSQL_HISTFILE="$XDG_STATE_HOME/mysql_history"
export PSQL_HISTORY="$XDG_STATE_HOME/psql_history"
export SQLITE_HISTORY="$XDG_STATE_HOME/sqlite_history"
export REDISCLI_HISTFILE="$XDG_STATE_HOME/redis/rediscli_history"

# =============================================================================
# macOS / Homebrew
# =============================================================================
export HOMEBREW_CACHE="$XDG_CACHE_HOME/homebrew"
export HOMEBREW_LOGS="$XDG_STATE_HOME/homebrew/logs"
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"

# =============================================================================
# Zoxide
# =============================================================================
export _ZO_DATA_DIR="$XDG_DATA_HOME/zoxide"
export _ZO_CACHE_DIR="$XDG_CACHE_HOME/zoxide"

# =============================================================================
# direnv — silence loading/unloading messages
# =============================================================================
export DIRENV_LOG_FORMAT=""

# =============================================================================
# Editor
# =============================================================================
export EDITOR='code --wait'
export VISUAL='code --wait'

# =============================================================================
# Claude Code
# Uses default ~/.claude for all contexts. LiteLLM auth injected via direnv
# (draftkings workspace) or dk-claude alias. External invocations (Alfred,
# PopClip) use ~/.claude/draftkings/tools/dkclaude wrapper.
# =============================================================================
alias p-claude='~/.local/bin/claude'  # bypass PATH; auth cleared by pclaude() in .aliases
alias dk-claude='LITELLM_BASE_URL=https://draftkings.litellm.com LITELLM_API_KEY=$(security find-generic-password -s "draftkings-litellm" -w) claude'

# =============================================================================
# Codex
# Uses profiles from ~/.codex/config.toml. Personal vs DK profiles selected
# via --profile flag.
# =============================================================================
alias p-codex='codex --profile personal'
alias dk-codex='codex --profile dk'

# =============================================================================
# PATH Construction (order matters: first match wins)
# =============================================================================
if [ -n "$ZSH_VERSION" ]; then
    # Zsh: use typeset -U for unique entries and path array
    typeset -U path
    path=(
        "$HOME/.local/bin"
        "$DOTNET_CLI_HOME/tools"
        "$GOPATH/bin"
        "/opt/homebrew/opt/ruby/bin"
        "/opt/homebrew/lib/ruby/gems/4.0.0/bin"
        "/opt/homebrew/opt/coreutils/libexec/gnubin"
        "/opt/homebrew/opt/make/libexec/gnubin"
        "/opt/homebrew/opt/grep/libexec/gnubin"
        "/opt/homebrew/opt/gawk/libexec/gnubin"
        "/usr/local/share/dotnet"
        "/opt/homebrew/bin"
        "/opt/homebrew/sbin"
        "/usr/local/bin"
        "/usr/local/sbin"
        "/usr/bin"
        "/bin"
        "/usr/sbin"
        "/sbin"
        $path
    )
else
    # Bash/sh/POSIX: build PATH string directly
    PATH="$HOME/.local/bin:$DOTNET_CLI_HOME/tools:$GOPATH/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
fi

export PATH

# bt-tools calendar used by Codex/PI/Claude scheduled flows
export DK_CALENDAR_NAME="DK"

# DraftKings workspace root for bt-tools scheduled flows
export DK_HOME="/Users/d.rambhia/Code/Repositories/draftkings"
