Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  ServerAliveInterval 240
  ServerAliveCountMax 10
  PermitLocalCommand yes
  StrictHostKeyChecking accept-new

Host github.com
  User git
  IdentityFile ~/.ssh/github_ed25519

Host bitbucket.build.dkinternal.com
  User git
  IdentityFile ~/.ssh/bitbucket_ed25519

Host staging-db
  HostName 10.100.5.105
  User admin
  LocalForward 5433 localhost:5432
  IdentitiesOnly yes
  IdentityFile ~/.ssh/homelab/unmemory_db_key

# Container network default: never fan out all agent keys (avoids the target's
# MaxAuthTries "Too many authentication failures"). Per-container keys live in
# SOPS, not on disk — use `task ssh -- <name|id>` for authenticated access.
# More-specific blocks above (e.g. staging-db) still win per keyword.
Host 10.100.*
  User admin
  IdentitiesOnly yes

Host homelab-socks
  HostName pangolin.rambtech.dev
  Port 2222
  User admin
  IdentityFile ~/.ssh/homelab/network_services_key
  IdentitiesOnly yes
  DynamicForward 1080
  ExitOnForwardFailure yes

# Route homelab IPs through SOCKS proxy when tunnel is active.
# Falls through to direct connection when on the home network.
Match host 10.100.*,192.168.1.* exec "nc -z 127.0.0.1 1080 2>/dev/null"
  ProxyCommand nc -x 127.0.0.1:1080 %h %p

Host homelab
  ForwardAgent yes
  HostName 192.168.1.215
  User root
  IdentityFile ~/.ssh/homelab/homelab
  IdentitiesOnly yes
  HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256,ecdsa-sha2-nistp256
