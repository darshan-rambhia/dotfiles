#!/usr/bin/env bash
# Wrapper around aws-cia for DraftKings AWS credential management.
# aws-cia writes STS creds as [dag-default]; this script normalizes
# them to [default] for compatibility with AWS CLI profiles.
#
# Usage:
#   dk-aws login          Full login (AD + MFA prompt)
#   dk-aws refresh        Refresh tokens silently (no AD/MFA)

set -euo pipefail

CIA="$(which aws-cia)"
export DOTNET_ROOT="${DOTNET_ROOT:-/opt/homebrew/opt/dotnet@8/libexec}"

CREDS_FILE="${AWS_SHARED_CREDENTIALS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/aws/credentials}"

sync_credentials() {
  # aws-cia writes to AWS_SHARED_CREDENTIALS_FILE as [dag-default]
  # Replace [dag-default] with [default] in place, keeping only the fresh credentials
  if [[ -f "$CREDS_FILE" ]]; then
    if grep -q "^\[dag-default\]" "$CREDS_FILE"; then
      # Extract just the [dag-default] section and rename to [default]
      sed -n '/^\[dag-default\]/,/^$/p' "$CREDS_FILE" | sed 's/^\[dag-default\]/[default]/' > "${CREDS_FILE}.tmp"
      mv "${CREDS_FILE}.tmp" "$CREDS_FILE"
      chmod 600 "$CREDS_FILE"
      echo "✓ Credentials normalized to [default] profile"
    else
      echo "✓ Credentials already in correct format"
    fi
  else
    echo "⚠ Credentials file not found at $CREDS_FILE"
    return 1
  fi
}

DK_USERNAME="${VAULT_USERNAME:-d.rambhia}"
DK_ROLE="${DK_AWS_ROLE:-3}"  # 3 = DAG-TechLeads

get_ad_password() {
  security find-generic-password -s "dk-ad-password" -w 2>/dev/null || {
    echo "Error: No AD password found in Keychain." >&2
    echo "Store it: security add-generic-password -a \"\$(whoami)\" -s \"dk-ad-password\" -w" >&2
    return 1
  }
}

auto_login() {
  local password
  password=$(get_ad_password) || exit 1

  expect -c "
    log_user 1
    set timeout 120
    spawn $CIA login
    expect \"Enter Username*\"
    send \"$DK_USERNAME\r\"
    expect \"Enter your password:\"
    send {$password}
    send \"\r\"
    set timeout -1
    interact {
      \"your role:\" {
        send \"$DK_ROLE\r\"
      }
    }
  "
}

case "${1:-help}" in
  login)
    if security find-generic-password -s "dk-ad-password" -w >/dev/null 2>&1; then
      auto_login
    else
      echo "No AD password in Keychain — falling back to interactive login."
      echo "To automate: security add-generic-password -a \"\$(whoami)\" -s \"dk-ad-password\" -w"
      "$CIA" login
    fi
    sync_credentials
    ;;
  refresh)
    "$CIA" login --refresh
    sync_credentials
    ;;
  help|--help|-h)
    echo "Usage: dk-aws <login|refresh>"
    echo ""
    echo "  login    Full login with AD credentials + MFA (auto-fills username/password/role from Keychain)"
    echo "  refresh  Refresh STS tokens without prompting"
    echo ""
    echo "To enable auto-login, store your AD password:"
    echo "  security add-generic-password -a \"\$(whoami)\" -s \"dk-ad-password\" -w"
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Usage: dk-aws <login|refresh>" >&2
    exit 1
    ;;
esac
