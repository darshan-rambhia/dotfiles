# Quick chezmoi sync to git
function chezmoi-push() {
  chezmoi git -- add -A && \
  chezmoi git -- commit -m "Dotfiles update - $(date +%Y-%m-%d)" && \
  chezmoi git -- push
}

# =============================================================================
# Functions
